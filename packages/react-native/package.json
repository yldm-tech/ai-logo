{
  "name": "@yldm-tech/ai-logo-rn",
  "version": "0.0.0",
  "private": true,
  "description": "Popular AI / LLM Model Brand Icons for React Native and Expo",
  "keywords": [
    "ai logo",
    "expo",
    "llm brand logo",
    "llm icons",
    "mobile icons",
    "react native icons",
    "react-native",
    "react-native-svg"
  ],
  "homepage": "https://ailogo.yldm.ai",
  "bugs": {
    "url": "https://github.com/yldm-tech/ai-logo/issues/new"
  },
  "license": "MIT",
  "author": "yldm-tech",
  "contributors": [
    "LobeHub <i@lobehub.com> (original author of lobehub/lobe-icons)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yldm-tech/ai-logo.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/esm/index.js",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "NODE_OPTIONS=\"--max-old-space-size=16384 --max-semi-space-size=1024\" tsup",
    "build:dts-only": "NODE_OPTIONS=\"--max-old-space-size=26384 --max-semi-space-size=1024\" tsup --dts-only",
    "build:no-dts": "NODE_OPTIONS=\"--max-old-space-size=16384 --max-semi-space-size=1024\" tsup --no-dts",
    "clean": "rm -rf dist",
    "lint": "vp lint src --fix",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:run": "vp test run",
    "test:watch": "vp test --watch",
    "type-check": "tsgo --noEmit"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-native": "^0.73.0",
    "clean-package": "^2.2.0",
    "expo-linear-gradient": "^57.0.2",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "expo-linear-gradient": ">=14.1.5",
    "react": "^19.0.0",
    "react-native": ">=0.76.9",
    "react-native-svg": ">=15.8.0"
  }
}
