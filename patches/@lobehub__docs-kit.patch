+// The site chrome is driven by the `--docs-*` palette in styles/globalStyles.ts.
+// antd paints `font-family: var(--ant-font-family)` on every component root, which
+// beats `body { font-family: var(--docs-font-sans) }` on specificity, so leaving the
+// antd seed alone would leave every antd subtree (cards, search, segmented controls,
+// tooltips, tables inside demos) rendering in a different typeface and radius family
+// from the shell around it. These two families are kept deliberately in sync.
+const SITE_FONT_STACK =
+  "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, 'JetBrains Mono', 'Cascadia Mono', Consolas, 'Liberation Mono', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', monospace";
+
+// `borderRadius` is a seed token, so it flows through the derivative; the LG/SM/XS/Outer
+// steps are map tokens and are applied by formatToken's override merge.
+const siteTokenOverrides = {
+  borderRadius: 2,
+  borderRadiusLG: 3,
+  borderRadiusOuter: 2,
+  borderRadiusSM: 2,
+  borderRadiusXS: 1,
+  fontFamily: SITE_FONT_STACK,
+  fontFamilyCode: SITE_FONT_STACK,
+};
+
 const buildLobeToken = (appearance: ThemeAppearance) => {
