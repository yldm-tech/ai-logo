{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es6",
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@yldm-tech/ai-logo": ["./src"],
      "@yldm-tech/ai-logo/*": ["./src/*"]
    }
  },
  "exclude": [".react-router"],
  "include": ["src", "docs", "tests", "docs.config.ts", "scripts"]
}
