# Gitignore for ai-logo
################################################################

# general
.DS_Store
.idea
.vscode
.history
.temp
.env.local
venv
temp
tmp

# dependencies
node_modules
*.log
*.lock
package-lock.json

# ci
coverage
.coverage
.eslintcache
.stylelintcache

# production
dist
es
logs
test-output

# docs
.react-router
react-router.config.mjs

# husky
.husky/prepare-commit-msg

# misc
# add other ignore file below
.env
*.patch
# pnpm patches are referenced from pnpm-workspace.yaml and have to be committed,
# or a clean install fails on a patch file that is not there.
!patches/*.patch
dist-treeshake
dist-treeshake-lookup
# Brand directories are named after the brand, and a machine-wide ignore such as Rust's target/ matches src/Target/ on case-insensitive filesystems. Negating here overrides core.excludesFile, so the brand is committed on every contributor's machine.
!src/Target/
!packages/react-native/src/icons/Target/
