{
  "name": "@yldm-tech/ai-logo",
  "version": "1.2.4",
  "description": "Popular AI / LLM Model Brand SVG Logo and Icon Collection",
  "keywords": [
    "ai icons",
    "ai logo",
    "llm brand logo",
    "llm icons",
    "react components",
    "svg icons"
  ],
  "homepage": "https://github.com/yldm-tech/ai-logo",
  "bugs": {
    "url": "https://github.com/yldm-tech/ai-logo/issues/new"
  },
  "license": "MIT",
  "author": "yldm-tech",
  "contributors": [
    "LobeHub <i@lobehub.com> (original author of lobehub/lobe-icons)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yldm-tech/ai-logo.git"
  },
  "workspaces": [
    "*",
    "packages/*",
    "apps/*"
  ],
  "files": [
    "es"
  ],
  "sideEffects": false,
  "main": "es/index.mjs",
  "module": "es/index.mjs",
  "types": "es/index.d.mts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "auto-converter-web-icons-to-rn": "tsx scripts/rn-conversion/auto-converter.ts --lint",
    "build": "tsx scripts/tocWorkflow/index.ts && vp pack src/index.ts --dts --format esm --out-dir es --unbundle",
    "build:rn": "pnpm --dir packages/react-native run build",
    "build:static": "npx puppeteer browsers install chrome && tsx scripts/svgWorkflow/index.tsx",
    "build:toc": "tsx scripts/tocWorkflow/index.ts",
    "build:watch": "vp pack src/index.ts --dts --format esm --out-dir es --unbundle --watch",
    "ci": "vp check && npm run type-check",
    "clean": "rm -r es dist coverage .react-router .eslintcache node_modules/.cache",
    "dev": "lobedocs dev",
    "docs:build": "lobedocs build",
    "docs:build-analyze": "ANALYZE=1 lobedocs build",
    "docs:dev": "lobedocs dev",
    "fmt": "vp fmt",
    "lint": "vp lint src tests --fix",
    "lint:circular": "dpdm src/**/*.{ts,tsx}  --warning false  --tree false  --exit-code circular:1  -T true",
    "lint:md": "remark . --quiet --frail --output",
    "lint:style": "stylelint \"{src,tests}/**/*.{js,jsx,ts,tsx}\" --fix",
    "postpack": "clean-package restore",
    "prepack": "clean-package",
    "prepare": "husky && npm run setup",
    "prepublishOnly": "npm run build",
    "pull": "git pull",
    "release": "semantic-release",
    "setup": "lobedocs typegen",
    "start": "npm run dev",
    "sync:md": "npm run build:toc && tsx scripts/readmeWorkflow/index.ts",
    "test": "vp test --passWithNoTests",
    "test:coverage": "vp test run --coverage  --passWithNoTests",
    "test:update": "vp test -u",
    "type-check": "tsgo --noEmit",
    "vectorizer": "tsx scripts/vectorizer/index.ts"
  },
  "dependencies": {
    "antd-style": "^4.1.0",
    "es-toolkit": "^1.52.0",
    "lucide-react": "^1.45.0",
    "polished": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@lobehub/commitlint-config": "^2.1.5",
    "@lobehub/docs-kit": "^5.27.3",
    "@lobehub/icons": "^5.18.0",
    "@lobehub/remarklint-config": "^2.1.5",
    "@lobehub/semantic-release-config": "^2.1.5",
    "@lobehub/stylelint-config": "^2.1.5",
    "@lobehub/ui": "^5.46.2",
    "@react-router/dev": "8.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "catalog:",
    "clean-package": "^2.2.0",
    "commitlint": "^21.2.2",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "dpdm": "^4.3.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "markdown-table": "^3.0.4",
    "p-map": "^7.0.8",
    "postcss-styled-syntax": "^0.7.2",
    "puppeteer": "^25.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.2.0",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "svgo": "4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@lobehub/ui": "^5.0.0",
    "antd": "^6.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml}": [
      "vp fmt"
    ],
    "*.{js,jsx,ts,tsx}": [
      "stylelint --fix",
      "vp lint --fix"
    ],
    "*.md": [
      "remark --quiet --output --"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
