# Both keys are npm's, and only npm reads this file — pnpm 12 takes its settings from pnpm-workspace.yaml and ignores .npmrc entirely (`pnpm config get package-lock` returns undefined against this file, and installs still report "Lockfile is up to date"). So nothing here affects pnpm-lock.yaml, which is committed and used.
#
# npm still runs in this repository: `npm run` drives the script chain, scripts/publish-alias.sh uses `npm pkg set` and `npm publish`, and the release workflow calls `npm view`. package-lock=false keeps any stray `npm install` from writing a second, competing lockfile beside the pnpm one.
package-lock=false
legacy-peer-deps=true
